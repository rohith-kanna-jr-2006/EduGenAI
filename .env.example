# Image Provider Configuration (gemini, openrouter, sdxl)
IMAGE_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite

# OpenRouter Fallback Configuration
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=black-forest-labs/flux-1-schnell
OPENROUTER_TIMEOUT_MS=180000
OPENROUTER_MAX_IMAGE_COST_USD=0.05

# Frontend & Server Settings
PORT=3000
REACT_APP_API_BASE_URL=
FRONTEND_URL=
CORS_ORIGIN=
LOG_LEVEL=info