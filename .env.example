# EduGenAI Full-Stack Environment Variables Example
# Copy this file to .env and configure your environment

# Frontend Configuration
REACT_APP_API_BASE_URL=http://localhost:5000/api

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/edugenai

# Redis Configuration (Optional for async generation jobs, fallback to async in-memory dev engine if absent)
REDIS_URL=redis://127.0.0.1:6379

# Model Provider Credentials (Server-only, never exposed to client)
# Hugging Face Inference API Token
HUGGINGFACE_API_KEY=your_huggingface_api_token_here

# Replicate API Token (Optional secondary provider)
REPLICATE_API_TOKEN=your_replicate_api_token_here

# Resource & Budget Guardrails
MAX_COST_PER_GENERATION_USD=0.05
APP_SPENDING_CAP_USD=10.00
USER_DAILY_QUOTA=50
DEFAULT_QUALITY_TIER=economy

# Logging Configuration
LOG_LEVEL=info
