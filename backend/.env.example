# EcoGen AI Backend Configuration
# Copy this file to .env and customize the values

# Server Settings
PORT=5000
NODE_ENV=development

# Frontend CORS Origin (e.g., http://localhost:5173 for Vite, http://localhost:3000 for CRA)
FRONTEND_URL=http://localhost:5173

# AI Image Generation Provider Settings
# Supported providers: openai, huggingface, pollinations
IMAGE_PROVIDER=openai

# API Key for chosen provider (never expose this in frontend code)
# - For OpenAI: your secret key starting with sk-...
# - For HuggingFace: your User Access Token starting with hf_...
# - For Pollinations: leave empty (open-access free provider)
IMAGE_API_KEY=

# Model to use (optional, defaults per provider)
# - OpenAI default: dall-e-3 (or dall-e-2)
# - HuggingFace default: black-forest-labs/FLUX.1-schnell (or stabilityai/stable-diffusion-xl-base-1.0)
IMAGE_MODEL=

# Resource Estimation Baseline Values (in Watt-hours)
# Note: These values are illustrative estimates, NOT verified hardware measurements
ECO_ENERGY_WH=0.5
HIGH_ENERGY_WH=2.0

# Average Grid Carbon Intensity in grams CO2e per kWh (Global average baseline: ~475 gCO2e/kWh)
GRID_CARBON_INTENSITY=475

# Request Timeout in milliseconds (default: 60000ms / 60 seconds)
REQUEST_TIMEOUT_MS=60000

# Rate Limiting Settings (Requests per window)
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=900000
