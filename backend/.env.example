# EduGenAI Backend Configuration Template
# Copy this file to .env and adjust your model and server parameters

# Server Settings
PORT=5000
NODE_ENV=development

# Allowed Frontend URL for CORS (e.g., http://localhost:5173 for Vite or http://localhost:3000 for CRA)
FRONTEND_URL=http://localhost:5173

# External Python SDXL Model Inference Service
# Point this to your Google Colab ngrok URL (e.g. https://xxxx.ngrok-free.app/generate)
# or local GPU server (http://localhost:8000/generate)
SDXL_MODEL_ENDPOINT=http://localhost:8000/generate

# Optional Authentication Token if your model endpoint requires it
SDXL_API_KEY=

# Inference Steps Policy Configuration
ECONOMY_STEPS=15
HIGH_QUALITY_STEPS=50

# Energy & Compute Baseline Values (in Watt-hours)
# Note: These values are illustrative estimates, NOT verified physical electricity measurements
ECO_ENERGY_WH=0.5
HIGH_ENERGY_WH=2.0

# Average Grid Carbon Intensity in grams CO2e per kWh (Global average baseline: ~475 gCO2e/kWh)
GRID_CARBON_INTENSITY=475

# Request Timeout for SDXL Diffusion in milliseconds (default: 90000ms / 90 seconds)
REQUEST_TIMEOUT_MS=90000

# Rate Limiting
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=900000
